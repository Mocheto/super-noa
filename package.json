{
  "name": "super-noa",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.github.config.ts",
    "build": "vite build --config vite.github.config.ts",
    "build:pages": "vite build --config vite.github.config.ts",
    "preview:pages": "vite preview --config vite.github.config.ts --outDir dist-pages",
    "test": "npm run lint && npm run test:logic && npm run build:pages",
    "test:logic": "node --experimental-strip-types --test src/game/*.test.ts server/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist-pages"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
